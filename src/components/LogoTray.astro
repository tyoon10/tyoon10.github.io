---
<div class="affiliations-row">
  <div class="brand-capsule" title="Anthropic">
    <img src="/media/logos/anthropic.svg" alt="Anthropic" class="brand-logo-img" style="height: 14px;" />
  </div>
  <div class="brand-capsule" title="Columbia Business School">
    <img src="/media/logos/cbs.png" alt="Columbia Business School" class="brand-logo-img" style="height: 28px;" />
  </div>
  <div class="brand-capsule" title="Columbia Engineering">
    <img src="/media/logos/columbia-engineering.png" alt="Columbia Engineering" class="brand-logo-img" style="height: 24px;" />
  </div>
  <div class="brand-capsule" title="CFA Society New York">
    <img src="/media/logos/cfany.png" alt="CFA Society New York" class="brand-logo-img" style="height: 24px;" />
  </div>
</div>

<style>
  .brand-logo-img {
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }
  .brand-capsule:hover .brand-logo-img {
    filter: grayscale(0%);
    opacity: 1;
  }
</style>
