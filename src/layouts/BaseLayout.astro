---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroImage from '../assets/hero-fireside-2560.jpg';
import '../styles/design-system.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  image?: ImageMetadata;
  /** Nav overlays a full-bleed dark hero and inverts on scroll. Homepage only —
   *  the system allows one cinematic moment per page. */
  heroOverlay?: boolean;
}

const {
  title,
  description = "Taewan Yoon's Personal Portfolio and Writing Space.",
  noindex = false,
  heroOverlay = false,
  image,
} = Astro.props;

const og = await getImage({
  src: image && image.format !== 'svg' ? image : heroImage,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
});
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Taewan Yoon</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon (BRAIN brand mark, carried over from legacy site) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph / SEO -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Taewan Yoon`} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Analytics 4 (same property as legacy site for seamless continuity) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H62WJ8E3J9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H62WJ8E3J9');
    </script>

    <!--
      Fonts. Newsreader is a variable serif (200–800 + optical sizing) and
      carries both the whisper-weight display and the broadsheet body, so the
      two serif choices resolve to one family. Inter is UI chrome only.
      JetBrains Mono owns labels, dates and code.

      Retired at the parchment cutover: Plus Jakarta Sans, Fira Code, and the
      full Font Awesome stylesheet — arrows are text glyphs now.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Navigation overlay={heroOverlay} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
