---
import BrainLayout from '../../layouts/BrainLayout.astro';
import * as copy from '../../data/brain/copy.ts';
import {
  archiveEvents,
  registerLabel,
  resolveUpcoming,
  upcomingEvent,
} from '../../data/brain/events.ts';

const upcoming = resolveUpcoming();
const next = upcomingEvent();
const archive = archiveEvents();
const iso = (s: string) => s.slice(0, 10).replace(/-/g, '·');
---

<BrainLayout
  title="Docket · BRAIN NYC"
  description="Sittings we chair, sittings we co-chair, and sittings on the docket."
>
  <section class="page-lead">
    <div class="brain-wrap">
      <span class="brain-section__label">Docket</span>
      <h1 class="h2">Sittings</h1>
      <p class="brain-deck">{copy.geographyNote}</p>
      <p class="caption stack-20">
        {copy.chairLegend.chair} · {copy.chairLegend['co-chair']} · {copy.chairLegend.docket}
      </p>
    </div>
  </section>

  <section class="brain-section" aria-labelledby="upcoming-label">
    <div class="brain-wrap">
      <span class="brain-section__label" id="upcoming-label">{copy.docketUpcomingLabel}</span>
      {upcoming.kind === 'held' || !next ? (
        <div class="held">
          <span class="chip chip--hold">{copy.chipLabels.hold}</span>
          <p>{upcoming.kind === 'held' ? upcoming.message : copy.nextHeld}</p>
        </div>
      ) : (
        <div class:list={['index', `role--${next.brain.chairRole}`]}>
          <div class="index__item">
            <span class="index__rail">
              <span class="chip chip--new">{next.brain.format}</span>
              <span class="date">{iso(next.date)}</span>
            </span>
            <div>
              <span class="index__title">{next.title}</span>
              <span class="index__meta">{next.location} · {copy.chairLegend[next.brain.chairRole]}{next.brain.inferred ? ` · ${copy.inferredMark}` : ''}</span>
            </div>
            <div class="index__action">
              <a class="btn" href={next.brain.organiserUrl}>
                {registerLabel(next)}
                <span class="visually-hidden"> for {next.title}</span>
              </a>
            </div>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="brain-section" aria-labelledby="archive-label">
    <div class="brain-wrap">
      <span class="brain-section__label" id="archive-label">{copy.docketArchiveLabel}</span>
      {archive.length === 0 ? (
        <div class="held">
          <span class="chip chip--hold">{copy.chipLabels.hold}</span>
          <p>{copy.docketEmptyArchive}</p>
        </div>
      ) : (
        <div class="index">
          {archive.map((event) => (
            <div class:list={['index__item', `role--${event.brain.chairRole}`]}>
              <span class="index__rail">
                <span class="chip chip--assemble">{event.brain.format}</span>
                <span class="date">{iso(event.date)}</span>
              </span>
              <div>
                <span class="index__title">{event.title}</span>
                <span class="index__meta">
                  {event.location} · {copy.chairLegend[event.brain.chairRole]}
                  {event.brain.inferred ? ` · ${copy.inferredMark}` : ''}
                </span>
              </div>
              <div class="index__action">
                <a class="link" href={event.brain.organiserUrl}>
                  {registerLabel(event)}
                  <span class="visually-hidden"> for {event.title}</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>
</BrainLayout>
