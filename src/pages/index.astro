---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoTray from '../components/LogoTray.astro';
import heroImage from '../assets/hero-fireside.jpg';
import { events } from '../data/events';

const allProjects = await getCollection('projects');
const allWritings = await getCollection('writings');

// Featured entries lead the list — position is the only "featured" signal the
// system allows, alongside a single accent-outlined pill.
const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const sortedWritings = allWritings.filter(w => !w.data.unlisted).sort(byDateDesc);
const homeWritings = [
  ...sortedWritings.filter(w => w.data.featured),
  ...sortedWritings.filter(w => !w.data.featured),
].slice(0, 4);

const sortedProjects = allProjects.sort(byDateDesc);
const homeProjects = [
  ...sortedProjects.filter(p => p.data.featured),
  ...sortedProjects.filter(p => !p.data.featured),
].slice(0, 4);

// Events — newest first; show latest 3, collapse the rest
const sortedEvents = events.slice().sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
const visibleEvents = sortedEvents.slice(0, 3);
const hiddenEvents = sortedEvents.slice(3);

// The cover story: newest featured writing that actually has an image.
const heroLead = homeWritings.find(w => w.data.coverImage) ?? homeWritings[0];

// Each section leads with one illustrated entry, then goes compact. The
// contrast between the two is what gives the page its rhythm.
const writingsRest = homeWritings.filter(w => w.id !== heroLead?.id);
const writingLead = writingsRest.find(w => w.data.coverImage) ?? writingsRest[0];
const writingList = writingsRest.filter(w => w.id !== writingLead?.id);

const projectLead = homeProjects.find(p => p.data.coverImage) ?? homeProjects[0];
const projectList = homeProjects.filter(p => p.id !== projectLead?.id);

// ISO dates, dot-separated — 2026·08·04
const iso = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '·');
const isoStr = (s: string) => s.slice(0, 10).replace(/-/g, '·');
---

<BaseLayout title="Systems Thinking for Applied AI" description="Personal portfolio of Taewan Yoon — leading AI ecosystems, PM, and strategic enterprise AI deployment." heroOverlay={true}>

  <!-- CINEMATIC HERO — the page's one full-bleed photographic moment -->
  <section class="hero-cine">
    <Image
      src={heroImage}
      alt="A fireside panel on stage before a packed auditorium at Columbia Business School"
      class="hero-cine__img"
      widths={[1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-cine__inner wrap">
      <h1 class="hero-cine__title">Systems thinking<br />for applied AI</h1>
      <p class="hero-cine__deck">
        A curious human exploring how frontier models translate into systems institutions can actually deploy. Always learning, experimenting, and occasionally sharing agent-native workflow designs.
      </p>
      <div class="hero-cine__actions">
        <a href="/projects" class="btn btn--ondark">Explore projects <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/writings" class="btn btn--ghost-ondark">Read my writing</a>
      </div>
    </div>
  </section>

  <!-- COVER STORY -->
  {heroLead && (
    <section class="section">
      <div class="wrap">
        <span class="section__label">Latest</span>
        <div class="lead lead--hero">
          {heroLead.data.coverImage && (
            <figure class="lead__media">
              <Image src={heroLead.data.coverImage} alt={heroLead.data.title} widths={[720, 1120, 1600]} sizes="(max-width: 1120px) 100vw, 1120px" />
            </figure>
          )}
          <div class="lead__body">
            <span class="index__meta">
              <span class="tag">{heroLead.data.tags[0] || 'AI Strategy'}</span>
              <span class="date">{iso(heroLead.data.date)}</span>
            </span>
            <a href={`/writings/${heroLead.id}`} class="lead__title">{heroLead.data.title}</a>
            <span class="lead__deck">{heroLead.data.description}</span>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ABOUT -->
  <section id="about" class="section">
    <div class="wrap">
      <span class="section__label">About</span>
      <h2 class="profile__name">
        Taewan Yoon, CFA
        <span class="profile__social">
          <a href="https://www.linkedin.com/in/taewan-yoon/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/tyoon10" target="_blank" rel="noopener">GitHub</a>
        </span>
      </h2>
      <div class="profile__body">
        <p>
          Columbia MBA/MS. Built and scaled Claude's NYC builder ecosystem from 0 to 1,000+ members. Led the AI Club through 4x growth to 900+ paid members, and co-organized the flagship AI Startup Challenge. Founded BRAIN, a cross-school startup network tackling the hardest business challenges with frontier AI.
        </p>
        <p>
          AI strategist, product manager, and startup community builder. Shipped agentic workflows as Manus AI Fellow, and co-founded AI-native fintech startup (acquired by a major insurance firm). Mentor at CFA Society New York.
        </p>
      </div>
      <div style="margin-top: 40px;"><LogoTray /></div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="section">
    <div class="wrap">
      <span class="section__label">Projects</span>

      {projectLead && (
        <div class="lead">
          {projectLead.data.coverImage && (
            <figure class="lead__media">
              <Image src={projectLead.data.coverImage} alt={projectLead.data.title} widths={[400, 640, 900]} sizes="(max-width: 760px) 100vw, 440px" />
            </figure>
          )}
          <div class="lead__body">
            <span class="index__meta">
              {projectLead.data.featured && <span class="tag tag--accent">Featured</span>}
              <span class="tag">{projectLead.data.tags[0] || 'Project'}</span>
              <span class="date">{iso(projectLead.data.date)}</span>
            </span>
            <a href={`/projects/${projectLead.id}`} class="lead__title">{projectLead.data.title}</a>
            <span class="lead__deck">{projectLead.data.description}</span>
          </div>
        </div>
      )}

      <div class="index">
        {projectList.map(p => (
          <div class="index__item">
            <span class="index__meta">
              {p.data.featured && <span class="tag tag--accent">Featured</span>}
              <span class="tag">{p.data.tags[0] || 'Project'}</span>
              <span class="date">{iso(p.data.date)}</span>
            </span>
            <a href={`/projects/${p.id}`} class="index__title">{p.data.title}</a>
            <span class="index__deck">{p.data.description}</span>
          </div>
        ))}
      </div>
      <a href="/projects" class="more-link">All projects <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <!-- WRITINGS -->
  <section id="posts" class="section">
    <div class="wrap">
      <span class="section__label">Writings &amp; Insights</span>

      {writingLead && (
        <div class="lead">
          {writingLead.data.coverImage && (
            <figure class="lead__media">
              <Image src={writingLead.data.coverImage} alt={writingLead.data.title} widths={[400, 640, 900]} sizes="(max-width: 760px) 100vw, 440px" />
            </figure>
          )}
          <div class="lead__body">
            <span class="index__meta">
              {writingLead.data.featured && <span class="tag tag--accent">Featured</span>}
              <span class="tag">{writingLead.data.tags[0] || 'AI Strategy'}</span>
              <span class="date">{iso(writingLead.data.date)}</span>
            </span>
            <a href={`/writings/${writingLead.id}`} class="lead__title">{writingLead.data.title}</a>
            <span class="lead__deck">{writingLead.data.description}</span>
          </div>
        </div>
      )}

      <div class="index">
        {writingList.map(w => (
          <div class="index__item">
            <span class="index__meta">
              {w.data.featured && <span class="tag tag--accent">Featured</span>}
              <span class="tag">{w.data.tags[0] || 'AI Strategy'}</span>
              <span class="date">{iso(w.data.date)}</span>
            </span>
            <a href={`/writings/${w.id}`} class="index__title">{w.data.title}</a>
            <span class="index__deck">{w.data.description}</span>
          </div>
        ))}
      </div>
      <a href="/writings" class="more-link">All writing <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <!-- EVENTS -->
  <section id="events" class="section">
    <div class="wrap">
      <span class="section__label">Events</span>

      {visibleEvents.map(ev => (
        <div class="event">
          <div>
            <a href={ev.links[0].url} target={ev.links[0].url.startsWith('http') ? '_blank' : null} rel={ev.links[0].url.startsWith('http') ? 'noopener' : null} class="event__title">{ev.title}</a>
            <span class="event__meta">
              <span class="tag">{ev.role}</span>
              <span class="date">{isoStr(ev.date)}</span>
              <span class="event__where">{ev.location}</span>
            </span>
          </div>
          <div class="event__actions">
            {ev.links.map(l => (
              <a href={l.url} target={l.url.startsWith('http') ? '_blank' : null} rel={l.url.startsWith('http') ? 'noopener' : null}>{l.name}</a>
            ))}
          </div>
        </div>
      ))}

      {hiddenEvents.length > 0 && (
        <div id="more-events" hidden>
          {hiddenEvents.map(ev => (
            <div class="event">
              <div>
                <a href={ev.links[0].url} target={ev.links[0].url.startsWith('http') ? '_blank' : null} rel={ev.links[0].url.startsWith('http') ? 'noopener' : null} class="event__title">{ev.title}</a>
                <span class="event__meta">
                  <span class="tag">{ev.role}</span>
                  <span class="date">{isoStr(ev.date)}</span>
                  <span class="event__where">{ev.location}</span>
                </span>
              </div>
              <div class="event__actions">
                {ev.links.map(l => (
                  <a href={l.url} target={l.url.startsWith('http') ? '_blank' : null} rel={l.url.startsWith('http') ? 'noopener' : null}>{l.name}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}

      {hiddenEvents.length > 0 && (
        <button type="button" id="toggle-events" class="more-link" aria-expanded="false" aria-controls="more-events" style="background: none; border: none; cursor: pointer; padding: 0;">
          Show {hiddenEvents.length} more events <span class="arrow" aria-hidden="true">&darr;</span>
        </button>
      )}
    </div>
  </section>

  <!-- CONTACT — the page's one change of ground, to close it -->
  <section id="contact" class="band-wash">
    <div class="wrap">
      <span class="section__label">Contact</span>
      <h2>Let's connect, build, and inspire.</h2>
      <p class="deck" style="margin-top: 16px;">
        Always learning, always building agentic systems and frameworks. If you're doing the same, I'd love to connect.
      </p>
      <div class="contact__actions">
        <button class="contact__email" id="email-btn"><span id="email-btn-text">contact@twyoon.com</span></button>
        <a href="https://linkedin.com/in/taewan-yoon" target="_blank" rel="noopener" class="link">LinkedIn</a>
        <a href="https://github.com/tyoon10" target="_blank" rel="noopener" class="link">GitHub</a>
      </div>
    </div>
  </section>

  <script is:inline>
    const emailBtn = document.getElementById('email-btn');
    const textSpan = document.getElementById('email-btn-text');

    if (emailBtn && textSpan) {
      emailBtn.addEventListener('click', () => {
        const email = 'contact@twyoon.com';
        navigator.clipboard.writeText(email).then(() => {
          textSpan.textContent = 'Copied';
          setTimeout(() => { textSpan.textContent = email; }, 1800);
        }).catch(err => {
          console.error('Could not copy email: ', err);
        });
      });
    }

    // Events expand / collapse
    const toggleBtn = document.getElementById('toggle-events');
    const moreEvents = document.getElementById('more-events');

    if (toggleBtn && moreEvents) {
      toggleBtn.addEventListener('click', () => {
        const expanded = moreEvents.hidden === false;
        moreEvents.hidden = expanded;
        toggleBtn.setAttribute('aria-expanded', String(!expanded));
        const count = moreEvents.querySelectorAll('.event').length;
        toggleBtn.innerHTML = expanded
          ? `Show ${count} more events <span class="arrow" aria-hidden="true">&darr;</span>`
          : `Show fewer events <span class="arrow" aria-hidden="true">&uarr;</span>`;
      });
    }
  </script>
</BaseLayout>
