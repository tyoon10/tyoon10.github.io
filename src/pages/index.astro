---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoTray from '../components/LogoTray.astro';
import heroImage from '../assets/hero-fireside.jpg';
import { events } from '../data/events';

const allProjects = await getCollection('projects');
const allWritings = await getCollection('writings');

// Featured entries lead the list — position is the only "featured" signal the
// system allows, alongside a single accent-outlined pill.
const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const sortedWritings = allWritings.filter(w => !w.data.unlisted).sort(byDateDesc);
const sortedProjects = allProjects.sort(byDateDesc);

// Events — newest first; show latest 3, collapse the rest
const sortedEvents = events.slice().sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());
const visibleEvents = sortedEvents.slice(0, 3);
const hiddenEvents = sortedEvents.slice(3);

// Each section opens with a featured row — a multi-column showcase split by
// vertical rules — then continues as compact hairline rows.
const featuredWritings = sortedWritings.filter(w => w.data.featured).slice(0, 3);
const featuredWritingIds = new Set(featuredWritings.map(w => w.id));
const writingList = sortedWritings.filter(w => !featuredWritingIds.has(w.id)).slice(0, 3);

// Projects ride a side-scrolling rail instead of a featured row plus a list,
// so they stay one continuous strip — featured first, everything else behind
// it in date order.
const railProjects = [
  ...sortedProjects.filter(p => p.data.featured),
  ...sortedProjects.filter(p => !p.data.featured),
].slice(0, 9);

// ISO dates, dot-separated — 2026·08·04
const iso = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '·');
const isoStr = (s: string) => s.slice(0, 10).replace(/-/g, '·');
---

<BaseLayout title="Systems Thinking for Applied AI" description="Personal portfolio of Taewan Yoon — leading AI ecosystems, PM, and strategic enterprise AI deployment." heroOverlay={true}>

  <!-- CINEMATIC HERO — the page's one full-bleed photographic moment -->
  <section class="hero-cine">
    <Image
      src={heroImage}
      alt="A fireside panel on stage before a packed auditorium at Columbia Business School"
      class="hero-cine__img"
      widths={[1280, 1920, 2560]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-cine__inner wrap">
      <h1 class="hero-cine__title">Systems thinking<br />for applied AI</h1>
      <p class="hero-cine__deck">
        <em>A curious human</em> exploring how frontier models translate into systems institutions can actually deploy. Always learning, experimenting, and occasionally sharing agent-native workflow designs.
      </p>
      <div class="hero-cine__actions">
        <a href="/projects" class="btn btn--ondark">Explore projects <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a href="/writings" class="btn btn--ghost-ondark">Read my writing</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="section">
    <div class="wrap">
      <span class="section__label">About</span>
      <h2 class="profile__name">
        Taewan Yoon, CFA
        <span class="profile__social">
          <a href="https://www.linkedin.com/in/taewan-yoon/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://github.com/tyoon10" target="_blank" rel="noopener">GitHub</a>
        </span>
      </h2>
      <div class="profile__body">
        <p>
          Columbia MBA/MS. Built and scaled Claude's NYC builder ecosystem from 0 to 1,000+ members. Led the AI Club through 4x growth to 900+ paid members, and co-organized the flagship AI Startup Challenge. Founded BRAIN, a cross-school startup network tackling the hardest business challenges with frontier AI.
        </p>
        <p>
          AI strategist, product manager, and startup community builder. Shipped agentic workflows as Manus AI Fellow, and co-founded AI-native fintech startup (acquired by a major insurance firm). Mentor at CFA Society New York.
        </p>
      </div>
      <div style="margin-top: 40px;"><LogoTray /></div>
    </div>
  </section>

  <!-- PROJECTS — full-bleed side-scrolling rail. Manual only: the arrows and
       the swipe move it, nothing moves it on its own. -->
  <section id="projects" class="section">
    <div class="rail" id="projects-rail">
      <div class="wrap">
        <div class="rail__head">
          <span class="section__label">Projects</span>
          <div class="rail__nav">
            <button type="button" class="rail__btn" data-rail-prev aria-controls="projects-track" aria-label="Scroll projects back">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M10.25 2.5 4.75 8l5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button type="button" class="rail__btn" data-rail-next aria-controls="projects-track" aria-label="Scroll projects forward">
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M5.75 2.5 11.25 8l-5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div class="rail__track" id="projects-track" role="group" aria-label="Projects" tabindex="0">
        {railProjects.map(p => (
          <a href={`/projects/${p.id}`} class="rail__card">
            {p.data.coverImage
              ? (
                <figure class="rail__media">
                  <Image src={p.data.coverImage} alt="" widths={[288, 576, 864]} sizes="288px" />
                </figure>
              )
              : <span class="rail__media" aria-hidden="true"></span>}
            <div class="rail__body">
              <span class="rail__meta">
                {p.data.featured && <span class="tag tag--featured">Featured</span>}
                <span class="tag">{p.data.tags[0] || 'Project'}</span>
                <span class="date">{iso(p.data.date)}</span>
              </span>
              <span class="rail__title">{p.data.title}</span>
              <span class="rail__deck">{p.data.description}</span>
            </div>
          </a>
        ))}

        <a href="/projects" class="rail__card rail__card--all">
          <span class="rail__all">
            <span class="rail__all-head">
              <span class="rail__all-count">{sortedProjects.length} case studies</span>
              <span class="rail__all-title">All projects</span>
            </span>
            <span class="rail__all-go" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </div>

      <div class="wrap">
        <div class="rail__foot">
          <div class="rail__progress" aria-hidden="true"><span class="rail__thumb"></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- WRITINGS -->
  <section id="posts" class="section">
    <div class="wrap">
      <span class="section__label">Writings &amp; Insights</span>

      {featuredWritings.length > 0 && (
        <div class="featured">
          {featuredWritings.map(w => (
            <div class="featured__item">
              {w.data.coverImage && (
                <figure class="featured__media">
                  <Image src={w.data.coverImage} alt={w.data.title} widths={[300, 600, 900]} sizes="300px" />
                </figure>
              )}
              <span class="featured__meta">
                <span class="tag tag--featured">Featured</span>
                <span class="tag">{w.data.tags[0] || 'AI Strategy'}</span>
                <span class="date">{iso(w.data.date)}</span>
              </span>
              <a href={`/writings/${w.id}`} class="featured__title">{w.data.title}</a>
              <span class="featured__deck">{w.data.description}</span>
            </div>
          ))}
        </div>
      )}

      <div class="index">
        {writingList.map(w => (
          <div class:list={["index__item", { "index__item--nomedia": !w.data.coverImage }]}>
            {w.data.coverImage && (
              <figure class="index__media">
                <Image src={w.data.coverImage} alt={w.data.title} widths={[200, 400, 600]} sizes="200px" />
              </figure>
            )}
            <span class="index__meta">
              <span class="tag">{w.data.tags[0] || 'AI Strategy'}</span>
              <span class="date">{iso(w.data.date)}</span>
            </span>
            <a href={`/writings/${w.id}`} class="index__title">{w.data.title}</a>
            <span class="index__deck">{w.data.description}</span>
          </div>
        ))}
      </div>
      <a href="/writings" class="more-link">All writing <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </section>

  <!-- EVENTS -->
  <section id="events" class="section">
    <div class="wrap">
      <span class="section__label">Events</span>

      {visibleEvents.map(ev => (
        <div class="event">
          <span class="event__rail">
            <span class="tag">{ev.role}</span>
            <span class="date">{isoStr(ev.date)}</span>
          </span>
          <div>
            <a href={ev.links[0].url} target={ev.links[0].url.startsWith('http') ? '_blank' : null} rel={ev.links[0].url.startsWith('http') ? 'noopener' : null} class="event__title">{ev.title}</a>
            <span class="event__where">{ev.location}</span>
          </div>
          <div class="event__actions">
            {ev.links.map(l => (
              <a href={l.url} target={l.url.startsWith('http') ? '_blank' : null} rel={l.url.startsWith('http') ? 'noopener' : null}>{l.name}</a>
            ))}
          </div>
        </div>
      ))}

      {hiddenEvents.length > 0 && (
        <div id="more-events" hidden>
          {hiddenEvents.map(ev => (
            <div class="event">
              <span class="event__rail">
                <span class="tag">{ev.role}</span>
                <span class="date">{isoStr(ev.date)}</span>
              </span>
              <div>
                <a href={ev.links[0].url} target={ev.links[0].url.startsWith('http') ? '_blank' : null} rel={ev.links[0].url.startsWith('http') ? 'noopener' : null} class="event__title">{ev.title}</a>
                <span class="event__where">{ev.location}</span>
              </div>
              <div class="event__actions">
                {ev.links.map(l => (
                  <a href={l.url} target={l.url.startsWith('http') ? '_blank' : null} rel={l.url.startsWith('http') ? 'noopener' : null}>{l.name}</a>
                ))}
              </div>
            </div>
          ))}
        </div>
      )}

      {hiddenEvents.length > 0 && (
        <button type="button" id="toggle-events" class="more-link" aria-expanded="false" aria-controls="more-events" style="background: none; border: none; cursor: pointer; padding: 0;">
          Show {hiddenEvents.length} more events <span class="arrow" aria-hidden="true">&darr;</span>
        </button>
      )}
    </div>
  </section>

  <!-- CONTACT — the page's one change of ground, to close it -->
  <section id="contact" class="band-wash">
    <div class="wrap">
      <span class="section__label">Contact</span>
      <div class="contact__grid">
        <div>
          <h2>Let's connect, build, and inspire.</h2>
          <p class="deck" style="margin-top: 18px;">
            Always learning, always building agentic systems and frameworks. If you're doing the same, I'd love to connect.
          </p>
        </div>
        <div class="contact__actions">
          <button class="contact__email" id="email-btn"><span id="email-btn-text">contact@twyoon.com</span></button>
          <a href="https://linkedin.com/in/taewan-yoon" target="_blank" rel="noopener" class="link">LinkedIn</a>
          <a href="https://github.com/tyoon10" target="_blank" rel="noopener" class="link">GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Project rail. Native scrolling does the moving; this only steps it by a
       card, keeps the arrows honest about the ends, and draws the position. -->
  <script is:inline>
    (function () {
      const rail = document.getElementById('projects-rail');
      const track = document.getElementById('projects-track');
      if (!rail || !track) return;

      const prev = rail.querySelector('[data-rail-prev]');
      const next = rail.querySelector('[data-rail-next]');
      const thumb = rail.querySelector('.rail__thumb');
      const smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

      // One card plus one gap, measured rather than assumed — the card width
      // is a clamp() and the gap changes at the mobile breakpoint.
      function step() {
        const cards = track.children;
        if (cards.length > 1) {
          const d = cards[1].offsetLeft - cards[0].offsetLeft;
          if (d > 0) return d;
        }
        return cards.length ? cards[0].getBoundingClientRect().width : track.clientWidth;
      }

      let queued = 0;
      function sync() {
        queued = 0;
        const max = Math.max(0, track.scrollWidth - track.clientWidth);
        const x = track.scrollLeft;

        rail.classList.toggle('rail--static', max <= 1);
        if (prev) prev.disabled = x <= 1;
        if (next) next.disabled = x >= max - 1;

        if (thumb) {
          const visible = track.scrollWidth > 0
            ? Math.min(1, track.clientWidth / track.scrollWidth)
            : 1;
          thumb.style.width = (visible * 100) + '%';
          thumb.style.left = (max > 0 ? (x / max) * (1 - visible) * 100 : 0) + '%';
        }
      }
      function queueSync() {
        if (!queued) queued = requestAnimationFrame(sync);
      }

      track.addEventListener('scroll', queueSync, { passive: true });
      window.addEventListener('resize', queueSync);
      if (prev) prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: smooth }));
      if (next) next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: smooth }));

      sync();
      // Covers cover images that land after first paint and change scrollWidth.
      window.addEventListener('load', queueSync);
    })();
  </script>

  <script is:inline>
    const emailBtn = document.getElementById('email-btn');
    const textSpan = document.getElementById('email-btn-text');

    if (emailBtn && textSpan) {
      emailBtn.addEventListener('click', () => {
        const email = 'contact@twyoon.com';
        navigator.clipboard.writeText(email).then(() => {
          textSpan.textContent = 'Copied';
          setTimeout(() => { textSpan.textContent = email; }, 1800);
        }).catch(err => {
          console.error('Could not copy email: ', err);
        });
      });
    }

    // Events expand / collapse
    const toggleBtn = document.getElementById('toggle-events');
    const moreEvents = document.getElementById('more-events');

    if (toggleBtn && moreEvents) {
      toggleBtn.addEventListener('click', () => {
        const expanded = moreEvents.hidden === false;
        moreEvents.hidden = expanded;
        toggleBtn.setAttribute('aria-expanded', String(!expanded));
        const count = moreEvents.querySelectorAll('.event').length;
        toggleBtn.innerHTML = expanded
          ? `Show ${count} more events <span class="arrow" aria-hidden="true">&darr;</span>`
          : `Show fewer events <span class="arrow" aria-hidden="true">&uarr;</span>`;
      });
    }
  </script>
</BaseLayout>
