---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../data/workshop-steps.json';

// Unlisted page: reachable only via direct URL / QR code.
// - noindex/nofollow via BaseLayout prop
// - excluded from sitemap in astro.config.mjs
//
// Labels are participant-facing and deliberately NOT the descriptions in
// commands.txt / PROMPTS.md, which are written to instruct. The instructor
// narrates live; this page only labels, so the two never compete.
// Regenerate src/data/workshop-steps.json rather than editing prose here.

const LAST_UPDATED = '3 August 2026';

const PACKAGE = {
  name: 'workshop-package.zip',
  size: '4 MB',
  // Direct download. Verified 2026-08-03: 4,262,174 bytes, sha256 bc777280cbe423a2,
  // permissions {role: reader, type: anyone} - no Google sign-in needed.
  //
  // NB: a delete-and-reupload in Drive mints a NEW file id and silently breaks this
  // link. Re-verify the id here whenever the package is replaced.
  url: 'https://drive.google.com/uc?export=download&id=1Zn4XAoPsq6bBqmbvbQ3cD1ShdDwyliKn',
  folderUrl: 'https://drive.google.com/drive/folders/1l8o1zGz3hIMGGXIqq_mZTlIEQOzxaPdR?usp=sharing',
  extractTo: 'C:\\Users\\Public',
  verify:
    'powershell -ExecutionPolicy Bypass -File C:\\Users\\Public\\folderhealth\\preflight.ps1 -Root "C:\\Users\\Public\\DealRoom"',
};

const { sections, takehome } = data;
const stepCount = sections.reduce((n: number, s: any) => n + s.steps.length, 0);

// The chip carries the word as well as the colour. Blue/orange measures ΔE 24.7 under
// simulated colour blindness where the previous blue/purple measured 7.8 - but the word
// is what makes the distinction safe, not the hue.
const label = (s: any) =>
  s.kind === 'command' ? `PowerShell · line ${s.id.replace('cmd-', '')}` : `Claude · ${s.id}`;
---

<BaseLayout
  title="Files Under Management — Session Sheet"
  description="Setup, commands and prompts for workshop participants."
  noindex={true}
>
  <section class="ws">
    <header class="ws-head">
      <p class="ws-eyebrow">Participant Session Sheet</p>
      <h1>Files Under Management</h1>
      <p class="ws-lede">
        Everything you type today, in order. Each step says where it goes —
        <b>PowerShell</b> or <b>Claude</b>. Click any step to open it.
      </p>
      <p class="ws-lede ws-free">
        <b>These are a starting point, not a script.</b> The PowerShell lines need to be
        copied exactly, because they move real files. Everything you say to Claude is
        yours — ask it anything, in your own words, and go wherever the folder takes you.
      </p>
      <p class="ws-stamp">Last updated {LAST_UPDATED}</p>
    </header>

    <!-- ── Setup ─────────────────────────────────────────────────────────── -->
    <section class="ws-block" id="setup">
      <div class="ws-blockhead">
        <span class="ws-blocknum">01</span>
        <div>
          <h2 class="ws-h2">Getting set up</h2>
          <p class="ws-blurb">
            We do this together now. Four steps, about ten minutes, no administrator
            rights needed. Stay with the room rather than running ahead — if something
            fails it is easier to fix while everyone is on the same step.
          </p>
        </div>
      </div>

      <ol class="ws-setup">
        <li>
          <h3>Download the package</h3>
          <a class="ws-btn" href={PACKAGE.url}>Download {PACKAGE.name} — {PACKAGE.size}</a>
          <p class="ws-fine">
            No Google sign-in needed. If the download is slow, say so — there are USB
            sticks in the room. Everything else lives in the
            <a href={PACKAGE.folderUrl} target="_blank" rel="noopener">materials folder</a>.
          </p>
        </li>

        <li>
          <h3>Extract it to exactly this location</h3>
          <div class="ws-copyrow">
            <code>{PACKAGE.extractTo}</code>
            <button class="ws-copy" data-copy={PACKAGE.extractTo} type="button">Copy</button>
          </div>
          <p class="ws-warn">
            <b>Do not accept the default.</b> Right-click the zip → <em>Extract All…</em> →
            replace the suggested folder with the path above. Some paths inside are long
            enough that extracting into Downloads exceeds the Windows limit and fails
            part way through, with no obvious error.
          </p>
          <p class="ws-fine">You should end up with three folders and one file.</p>
        </li>

        <li>
          <h3>Check it worked</h3>
          <div class="ws-copyrow">
            <code>{PACKAGE.verify}</code>
            <button class="ws-copy" data-copy={PACKAGE.verify} type="button">Copy</button>
          </div>
          <p class="ws-fine">
            Press Start, type <em>PowerShell</em>, press Enter, then paste that in. The
            last line should read <b>RESULT: READY</b>. <code>WARN</code> rows are
            expected. If it says the folder was not found, the extract went somewhere
            else — say so rather than retrying.
          </p>
        </li>

        <li>
          <h3>Open Claude on the documents</h3>
          <div class="ws-copyrow">
            <code>C:\Users\Public\DealRoom</code>
            <button class="ws-copy" data-copy="C:\Users\Public\DealRoom" type="button">Copy</button>
          </div>
          <p class="ws-fine">
            The documents themselves — not the tools folder. We move to the tools folder
            partway through, and the reason we move is one of the things this session is
            about.
          </p>
        </li>
      </ol>
    </section>

    <!-- ── Index ─────────────────────────────────────────────────────────── -->
    <nav class="ws-index" aria-label="Session sections">
      <p class="ws-indexhead">The session &middot; {sections.length + 1} parts, {stepCount} steps</p>
      <ol>
        <li>
          <a href="#setup">
            <span class="ws-idxnum">01</span>
            <span class="ws-idxname">Getting set up</span>
            <span class="ws-idxcount">4</span>
          </a>
        </li>
        {sections.map((sec: any, i: number) => (
          <li>
            <a href={`#${sec.id}`}>
              <span class="ws-idxnum">{String(i + 2).padStart(2, '0')}</span>
              <span class="ws-idxname">{sec.name}</span>
              <span class="ws-idxcount">{sec.steps.length}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <!-- ── Sections ──────────────────────────────────────────────────────── -->
    {sections.map((sec: any, i: number) => (
      <section class="ws-block" id={sec.id}>
        <div class="ws-blockhead">
          <span class="ws-blocknum">{String(i + 2).padStart(2, '0')}</span>
          <div>
            <h2 class="ws-h2">{sec.name}</h2>
            <p class="ws-blurb">{sec.blurb}</p>
          </div>
        </div>
        {/* section numbering continues from the setup block, which is 01 */}

        {sec.resources && sec.resources.length > 0 && (
          <div class="ws-res">
            {sec.resources.map((r: any) => (
              <a class="ws-reslink" href={r.url} target="_blank" rel="noopener">
                <span class="ws-restag">Reference</span>
                <span class="ws-resbody">
                  <span class="ws-reslabel">{r.label}</span>
                  <span class="ws-resnote">{r.note}</span>
                </span>
              </a>
            ))}
          </div>
        )}

        <div class="ws-steps">
          {sec.steps.map((s: any) => (
            <details class:list={['ws-step', `is-${s.kind}`]} id={s.id}>
              <summary>
                <span class:list={['ws-tag', `tag-${s.kind}`]}>{label(s)}</span>
                <span class="ws-title">{s.title}</span>
                <span class="ws-what">{s.blurb}</span>
                <span class="ws-chev" aria-hidden="true"></span>
              </summary>
              <div class="ws-bodywrap">
                <pre class="ws-body">{s.body}</pre>
                <button class="ws-copy ws-copywide" data-copy={s.body} type="button">
                  {s.kind === 'command' ? 'Copy command' : 'Copy prompt'}
                </button>
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}

    <!-- ── Take-home ─────────────────────────────────────────────────────── -->
    <section class="ws-block" id="take-home">
      <div class="ws-blockhead">
        <span class="ws-blocknum">&rarr;</span>
        <div>
          <h2 class="ws-h2">Taking it home</h2>
          <p class="ws-blurb">
            The same tools on your own folders. No install, no network, no admin rights.
            The first steps only read and measure. Do not apply anything on day one.
          </p>
        </div>
      </div>

      <div class="ws-note">
        <p><b>There is a <code>take-home</code> folder in the package</b></p>
        <p><code>starter-CLAUDE.md</code> is a fuller set of rules than the one we write
        together, with the reasoning attached to each. <code>folder-health-audit</code>
        is the skill from the session, ready to adapt.</p>
      </div>

      <div class="ws-steps">
        {takehome.map((s: any) => (
          <details class:list={['ws-step', `is-${s.kind}`]} id={s.id}>
            <summary>
              <span class:list={['ws-tag', `tag-${s.kind}`]}>{s.id}</span>
              <span class="ws-title">{s.title}</span>
              <span class="ws-what">{s.blurb}</span>
              <span class="ws-chev" aria-hidden="true"></span>
            </summary>
            <div class="ws-bodywrap">
              <pre class="ws-body">{s.body}</pre>
              <button class="ws-copy ws-copywide" data-copy={s.body} type="button">Copy</button>
            </div>
          </details>
        ))}
      </div>
    </section>

    <p class="ws-foot">
      Shared by direct link for workshop participants. Not part of the site's public
      navigation.
    </p>
  </section>
</BaseLayout>

<script>
  // Copy-to-clipboard with a fallback for browsers that block the async Clipboard API.
  // A silently dead copy button costs the room minutes, so failure is surfaced on the
  // button and the text is selected for a manual Ctrl+C.
  document.querySelectorAll<HTMLButtonElement>('.ws-copy').forEach((btn) => {
    btn.addEventListener('click', async (ev) => {
      ev.preventDefault();
      const text = btn.dataset.copy ?? '';
      const original = btn.textContent;

      const legacy = () => {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        document.body.removeChild(ta);
        return ok;
      };

      let copied = false;
      if (navigator.clipboard && window.isSecureContext) {
        try { await navigator.clipboard.writeText(text); copied = true; }
        catch { copied = legacy(); }
      } else { copied = legacy(); }

      btn.textContent = copied ? 'Copied' : 'Press Ctrl+C';
      btn.classList.add(copied ? 'is-copied' : 'is-failed');
      if (!copied) {
        const pre = btn.previousElementSibling;
        if (pre) {
          const r = document.createRange();
          r.selectNodeContents(pre);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(r);
        }
      }
      window.setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('is-copied', 'is-failed');
      }, 2000);
    });
  });

  // Deep link to a step opens it.
  const openHash = () => {
    if (!location.hash) return;
    const el = document.querySelector(location.hash);
    if (el instanceof HTMLDetailsElement) el.open = true;
  };
  openHash();
  window.addEventListener('hashchange', openHash);
</script>

<style>
  .ws { max-width: 820px; margin: 0 auto; padding: 48px 0 72px; }

  .ws-eyebrow {
    font-family: 'Fira Code', monospace; font-size: 0.78rem; letter-spacing: 0.13em;
    text-transform: uppercase; color: var(--text-muted); margin-bottom: 8px;
  }
  .ws-head h1 { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2rem; margin: 0 0 12px; }
  .ws-lede { color: var(--text-muted); line-height: 1.7; max-width: 62ch; margin: 0; }
  .ws-lede b { color: var(--text-main); font-weight: 600; }
  .ws-free {
    margin-top: 14px; padding: 13px 16px; background: var(--bg-surface-solid);
    border: 1px solid var(--border-color); border-radius: 10px; font-size: 0.94rem;
  }
  .ws-stamp {
    margin-top: 12px; font-family: 'Fira Code', monospace;
    font-size: 0.72rem; color: var(--text-muted);
  }

  .ws-block { margin-top: 44px; scroll-margin-top: 24px; }
  .ws-h2 { font-size: 1.2rem; margin: 0; }
  .ws-blurb { color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 4px 0 0; max-width: 62ch; }

  .ws-blockhead { display: flex; gap: 14px; align-items: baseline; margin-bottom: 18px; }
  .ws-blocknum {
    font-family: 'Fira Code', monospace; font-size: 0.95rem; color: var(--text-muted);
    flex: 0 0 auto; min-width: 24px;
  }

  /* Index */
  .ws-index {
    margin-top: 44px; background: var(--bg-surface); border: 1px solid var(--border-color);
    border-radius: 14px; padding: 20px 22px; box-shadow: var(--card-shadow);
  }
  .ws-indexhead {
    font-family: 'Fira Code', monospace; font-size: 0.72rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--text-muted); margin: 0 0 12px;
  }
  .ws-index ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 1px; }
  .ws-index a {
    display: flex; align-items: baseline; gap: 12px; padding: 7px 8px;
    text-decoration: none; color: var(--text-main); border-radius: 8px;
    transition: var(--physic-transition);
  }
  .ws-index a:hover { background: var(--bg-surface-hover); }
  .ws-idxnum { font-family: 'Fira Code', monospace; font-size: 0.75rem; color: var(--text-muted); }
  .ws-idxname { flex: 1 1 auto; font-size: 0.95rem; }
  .ws-idxcount {
    font-family: 'Fira Code', monospace; font-size: 0.75rem; color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Reference material — deliberately not styled like a step, because it is not
     something to run. Dashed edge and no left accent bar. */
  .ws-res { margin-bottom: 12px; display: flex; flex-direction: column; gap: 8px; }
  .ws-reslink {
    display: flex; align-items: baseline; gap: 12px; padding: 12px 15px;
    background: var(--bg-surface-solid); border: 1px dashed var(--rule-firm, #c3c2b7);
    border-radius: 10px; text-decoration: none; color: var(--text-main);
    transition: var(--physic-transition);
  }
  .ws-reslink:hover { background: var(--bg-surface-hover); border-style: solid; }
  .ws-restag {
    font-family: 'Fira Code', monospace; font-size: 0.66rem; letter-spacing: 0.07em;
    text-transform: uppercase; color: var(--text-muted); flex: 0 0 auto; padding-top: 2px;
  }
  .ws-resbody { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ws-reslabel { font-size: 0.94rem; font-weight: 600; }
  .ws-reslabel::after { content: ' \2192'; color: var(--text-muted); font-weight: 400; }
  .ws-resnote { font-size: 0.86rem; color: var(--text-muted); line-height: 1.5; }

  /* Steps */
  .ws-steps { display: flex; flex-direction: column; gap: 8px; }

  .ws-step {
    background: var(--bg-surface); border: 1px solid var(--border-color);
    border-left: 3px solid var(--border-color); border-radius: 10px;
    overflow: hidden; transition: var(--physic-transition); scroll-margin-top: 24px;
  }
  .ws-step.is-command { border-left-color: #2a78d6; }
  .ws-step.is-prompt  { border-left-color: #eb6834; }
  .ws-step[open] { box-shadow: var(--card-shadow); }

  .ws-step summary {
    display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
    padding: 13px 16px; cursor: pointer; list-style: none;
  }
  .ws-step summary::-webkit-details-marker { display: none; }
  .ws-step summary:hover { background: var(--bg-surface-hover); }
  .ws-step summary:focus-visible { outline: 2px solid var(--text-highlight); outline-offset: -2px; }

  .ws-tag {
    font-family: 'Fira Code', monospace; font-size: 0.68rem; padding: 3px 7px;
    border-radius: 5px; flex: 0 0 auto; white-space: nowrap;
  }
  .tag-command { background: rgba(42, 120, 214, 0.10); color: #1a5296; }
  .tag-prompt  { background: rgba(235, 104, 52, 0.13); color: #a8401a; }

  .ws-title { font-size: 0.97rem; font-weight: 600; flex: 0 0 auto; }
  .ws-what { font-size: 0.87rem; color: var(--text-muted); flex: 1 1 240px; line-height: 1.45; }

  .ws-chev {
    flex: 0 0 auto; width: 9px; height: 9px; margin-left: auto; margin-top: 4px;
    border-right: 1.5px solid var(--text-muted); border-bottom: 1.5px solid var(--text-muted);
    transform: rotate(45deg); transition: transform 0.18s ease;
  }
  .ws-step[open] .ws-chev { transform: rotate(-135deg); }

  .ws-bodywrap { padding: 0 16px 16px; }
  .ws-body {
    background: var(--bg-surface-solid); border: 1px solid var(--border-color);
    border-radius: 9px; padding: 14px 16px; font-family: 'Fira Code', monospace;
    font-size: 0.79rem; line-height: 1.62; white-space: pre-wrap; word-break: break-word;
    overflow-x: auto; margin: 0;
  }

  /* Setup */
  .ws-setup { list-style: none; counter-reset: s; padding: 0; margin: 0 0 20px; display: flex; flex-direction: column; gap: 16px; }
  .ws-setup > li {
    counter-increment: s; position: relative; padding: 20px 22px 20px 56px;
    background: var(--bg-surface); border: 1px solid var(--border-color);
    border-radius: 12px; box-shadow: var(--card-shadow);
  }
  .ws-setup > li::before {
    content: counter(s); position: absolute; left: 20px; top: 20px;
    width: 24px; height: 24px; border-radius: 50%; background: var(--text-main); color: #fff;
    font-family: 'Fira Code', monospace; font-size: 0.78rem;
    display: flex; align-items: center; justify-content: center;
  }
  .ws-setup h3 { font-size: 1rem; margin: 0 0 12px; }

  .ws-warn {
    background: rgba(217, 119, 6, 0.07); border-left: 2px solid #d97706;
    padding: 11px 14px; border-radius: 0 8px 8px 0; line-height: 1.6;
    font-size: 0.89rem; margin: 12px 0 0;
  }
  .ws-fine { color: var(--text-muted); font-size: 0.88rem; line-height: 1.6; margin: 10px 0 0; }

  .ws-note {
    background: var(--bg-surface-solid); border: 1px solid var(--border-color);
    border-radius: 11px; padding: 15px 18px; margin-bottom: 18px;
  }
  .ws-note p { margin: 0; line-height: 1.6; }
  .ws-note p + p { margin-top: 5px; color: var(--text-muted); font-size: 0.9rem; }

  /* Buttons */
  .ws-btn {
    display: inline-block; background: var(--text-main); color: #fff; text-decoration: none;
    font-size: 0.9rem; font-weight: 500; padding: 10px 18px; border-radius: 10px;
    transition: var(--physic-transition);
  }
  .ws-btn:hover { opacity: 0.86; transform: translateY(-1px); }

  .ws-copyrow { display: flex; align-items: stretch; gap: 8px; }
  .ws-copyrow code {
    flex: 1 1 auto; background: var(--bg-surface-solid); border: 1px solid var(--border-color);
    border-radius: 9px; padding: 10px 13px; font-family: 'Fira Code', monospace;
    font-size: 0.79rem; overflow-x: auto; white-space: nowrap;
  }
  .ws-copy {
    flex: 0 0 auto; background: var(--bg-surface-solid); border: 1px solid var(--border-color);
    border-radius: 9px; padding: 0 15px; font-family: 'Inter', sans-serif; font-size: 0.83rem;
    color: var(--text-main); cursor: pointer; transition: var(--physic-transition);
  }
  .ws-copy:hover { background: var(--bg-surface-hover); }
  .ws-copy.is-copied { background: var(--badge-bg-key); color: var(--badge-text-key); border-color: transparent; }
  .ws-copy.is-failed { background: rgba(217,119,6,0.1); color: #b45309; border-color: transparent; }
  .ws-copywide { width: 100%; padding: 9px 15px; margin-top: 9px; }

  .ws-foot { margin-top: 52px; font-size: 0.8rem; color: var(--text-muted); }

  @media (max-width: 640px) {
    .ws-head h1 { font-size: 1.6rem; }
    .ws-setup > li { padding: 17px 15px 17px 48px; }
    .ws-setup > li::before { left: 15px; }
    .ws-copyrow { flex-direction: column; }
    .ws-copy { padding: 9px 15px; }
    .ws-what { flex-basis: 100%; }
    .ws-chev { display: none; }
  }
</style>
