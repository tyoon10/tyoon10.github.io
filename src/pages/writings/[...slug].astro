---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map(entry => ({
    params: { slug: entry.id }, // Map Astro v5 entry.id to slug parameter
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="section-spacing subpage-content" style="max-width: 720px; margin: 0 auto;">

    <!-- Header meta info -->
    <div style="margin-bottom: 40px; border-bottom: 1px solid var(--border-color); padding-bottom: 28px;">
      <div class="article-card-meta" style="margin-bottom: 16px;">
        <span class="category-chip">{entry.data.tags[0] || 'AI Strategy'}</span>
        {entry.data.tags.slice(1).map(tag => (
          <span class="category-chip" style="color: #a855f7 !important; background: rgba(168, 85, 247, 0.05); border-color: rgba(168, 85, 247, 0.12);">{tag}</span>
        ))}
        <span style="margin: 0 8px;">•</span>
        <span>{entry.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
      </div>

      <h1 style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 2.5rem; font-weight: 800; line-height: 1.15; letter-spacing: -0.03em; color: var(--text-main); margin-bottom: 18px;">
        {entry.data.title}
      </h1>

      <p class="hero-lead" style="font-size: 1.1rem; line-height: 1.6; margin-bottom: {entry.data.coverImage ? '28px' : '0'};">
        {entry.data.description}
      </p>

      {entry.data.coverImage && (
        <Image
          src={entry.data.coverImage}
          alt={entry.data.title}
          widths={[720, 1080, 1440]}
          sizes="(max-width: 720px) 100vw, 720px"
          style="width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--border-color); display: block;"
        />
      )}

      {entry.data.links && entry.data.links.length > 0 && (
        <div class="tech-chips" style="gap: 12px; margin-top: 24px;">
          {entry.data.links.map(l => (
            <a href={l.url} target={l.url.startsWith('http') ? '_blank' : null} rel={l.url.startsWith('http') ? 'noopener' : null} class="timeline-action-btn" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
              {l.icon === 'linkedin' && <i class="fab fa-linkedin"></i>}
              {l.icon === 'github' && <i class="fab fa-github"></i>}
              {l.icon === 'globe' && <i class="fas fa-globe"></i>}
              {l.icon === 'book-open' && <i class="fas fa-book-open"></i>}
              {l.icon === 'comments' && <i class="fas fa-comments"></i>}
              {l.icon === 'video' && <i class="fas fa-video"></i>}
              {l.name}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Compiled Markdown Content -->
    <div class="markdown-body">
      <Content />
    </div>

    <!-- Back to Catalog Link -->
    <div style="margin-top: 60px; border-top: 1px solid var(--border-color); padding-top: 24px;">
      <a href="/writings" class="action-anchor" style="font-size: 0.9rem;">
        <i class="fas fa-arrow-left" style="margin-right: 6px;"></i> Back to all articles
      </a>
    </div>

  </article>
</BaseLayout>
