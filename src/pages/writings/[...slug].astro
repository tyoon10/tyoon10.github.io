---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map(entry => ({
    params: { slug: entry.id }, // Map Astro v5 entry.id to slug parameter
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

---

<BaseLayout title={entry.data.title} description={entry.data.description} noindex={entry.data.unlisted} image={entry.data.coverImage}>
  <article class="article">
    <ArticleHeader entry={entry} />

    <div class="markdown-body">
      <Content />
    </div>

    <div class="article__foot">
      <a href="/writings" class="back-link"><span aria-hidden="true">&larr;</span> Back to all articles</a>
    </div>

  </article>
</BaseLayout>
