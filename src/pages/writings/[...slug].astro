---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map(entry => ({
    params: { slug: entry.id }, // Map Astro v5 entry.id to slug parameter
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const iso = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '·');
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="article">

    <header class="article__header">
      <div class="article__meta">
        {entry.data.tags.slice(0, 3).map(tag => <span class="tag">{tag}</span>)}
        <span class="date">{iso(entry.data.date)}</span>
      </div>

      <h1 class="article__title">{entry.data.title}</h1>

      <p class="article__deck">{entry.data.description}</p>

      {entry.data.coverImage && (
        <Image
          src={entry.data.coverImage}
          alt={entry.data.title}
          widths={[720, 1080, 1440]}
          sizes="(max-width: 720px) 100vw, 720px"
          class="article__cover"
        />
      )}

      {entry.data.links && entry.data.links.length > 0 && (
        <div class="article__links">
          {entry.data.links.map(l => (
            <a href={l.url} target={l.url.startsWith('http') ? '_blank' : null} rel={l.url.startsWith('http') ? 'noopener' : null} class="link">{l.name}</a>
          ))}
        </div>
      )}
    </header>

    <div class="markdown-body">
      <Content />
    </div>

    <div style="margin-top: 64px; border-top: 1px solid var(--rule); padding-top: 26px;">
      <a href="/writings" class="back-link"><span aria-hidden="true">&larr;</span> Back to all articles</a>
    </div>

  </article>
</BaseLayout>
