---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allWritings = await getCollection('writings');
const sortedWritings = allWritings
  .filter(w => !w.data.unlisted)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const iso = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '·');
---

<BaseLayout title="Writings & Insights" description="Deep dives into model architectures, startup pipelines, skincare photobiology, and strategic product roadmaps by Taewan Yoon.">
  <section class="section" style="margin-top: 64px;">
    <div class="wrap">
      <span class="section__label">Writings &amp; Insights</span>
      <h2>Everything I've published.</h2>
      <p class="deck" style="margin: 16px 0 44px;">
        Tactical checklists, research audits, and structural frameworks on advanced AI ecosystems and data science.
      </p>

      <div class="index">
        {sortedWritings.map(writing => (
          <div class="index__item">
            <span class="index__meta">
              {writing.data.featured && <span class="tag tag--accent">Featured</span>}
              <span class="tag">{writing.data.tags[0] || 'AI Strategy'}</span>
              {writing.data.tags[1] && <span class="tag">{writing.data.tags[1]}</span>}
              <span class="date">{iso(writing.data.date)}</span>
            </span>
            <a href={`/writings/${writing.id}`} class="index__title">{writing.data.title}</a>
            <span class="index__deck">{writing.data.description}</span>
          </div>
        ))}
      </div>

      <a href="/" class="more-link"><span class="arrow" aria-hidden="true">&larr;</span> Back to homepage</a>
    </div>
  </section>
</BaseLayout>
